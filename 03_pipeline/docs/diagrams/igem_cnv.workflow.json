{
  "schema_version": 2,
  "diagram_type": "workflow",
  "meta": {
    "title": "CNV 工作流：从 scRNA-seq 到候选基因",
    "locale": "zh-CN",
    "quality_profile": "showcase"
  },
  "lanes": [
    { "id": "inputs", "label": "数据与注释" },
    { "id": "infer", "label": "CNV 推断（infercnv）" },
    { "id": "segout", "label": "片段与产出（call-segments · extract-genes）" },
    { "id": "consume", "label": "下游" }
  ],
  "phases": [
    { "id": "ph-prep", "label": "① 输入与准备", "fromCol": 0, "toCol": 1 },
    { "id": "ph-infer", "label": "② 表达推断", "fromCol": 2, "toCol": 3 },
    { "id": "ph-out", "label": "③ 片段与基因产出", "fromCol": 4, "toCol": 5 }
  ],
  "mainPath": ["geo", "stage10x", "loadqc", "norm", "runinfer", "winsig", "robz", "extract", "cand"],
  "semanticChecks": {
    "allowedRoots": ["geo", "gtf"],
    "allowedTerminals": ["cand"]
  },
  "nodes": [
    { "id": "geo", "lane": "inputs", "col": 0, "type": "external", "label": "GEO 原始文件", "sublabel": "WS1 患者 + CTRL1 对照", "width": 118 },
    { "id": "gtf", "lane": "inputs", "col": 1, "type": "external", "label": "GENCODE GTF", "sublabel": "蛋白编码基因 · GRCh38", "width": 118 },
    { "id": "prepare_order", "lane": "inputs", "col": 2, "type": "backend", "label": "prepare-order", "sublabel": "GTF → 基因排序表", "width": 112 },
    { "id": "stage10x", "lane": "infer", "col": 0, "type": "backend", "label": "① stage-samples", "sublabel": "GEO → 10x · 2列→3列", "width": 118 },
    { "id": "loadqc", "lane": "infer", "col": 1, "type": "backend", "label": "加载 + QC", "sublabel": "≥200基因 · mito<20%", "width": 110 },
    { "id": "norm", "lane": "infer", "col": 2, "type": "backend", "label": "归一化 + 坐标排序", "sublabel": "normalize+log1p · chr/start", "width": 128 },
    { "id": "runinfer", "lane": "infer", "col": 3, "type": "backend", "label": "infercnvpy 推断", "sublabel": "100/10 · 25/5 两档窗口", "width": 120, "tag": "回退路径" },
    { "id": "winsig", "lane": "infer", "col": 4, "type": "database", "label": "窗口信号表", "sublabel": "score=患者均值", "width": 106 },
    { "id": "robz", "lane": "segout", "col": 4, "type": "backend", "label": "④ call-segments", "sublabel": "robust z ≤ −1.5 · ≤10 Mb", "width": 128 },
    { "id": "extract", "lane": "segout", "col": 5, "type": "backend", "label": "⑤ extract-genes", "sublabel": "区间→基因 · QC · 验收", "width": 118 },
    { "id": "cand", "lane": "consume", "col": 5, "type": "database", "label": "candidates.csv", "sublabel": "35 基因 → L1", "width": 100 }
  ],
  "edges": [
    { "from": "geo", "to": "stage10x", "label": "10x mtx", "variant": "emphasis", "role": "main" },
    { "from": "stage10x", "to": "loadqc", "label": "per-sample 10x", "variant": "emphasis", "role": "main" },
    { "from": "loadqc", "to": "norm", "variant": "default", "role": "main" },
    { "from": "norm", "to": "runinfer", "variant": "default", "role": "main" },
    { "from": "runinfer", "to": "winsig", "label": "窗口信号", "variant": "emphasis", "role": "main" },
    { "from": "winsig", "to": "robz", "variant": "emphasis", "role": "main" },
    { "from": "robz", "to": "extract", "label": "缺失片段", "variant": "emphasis", "role": "main" },
    { "from": "extract", "to": "cand", "variant": "emphasis", "role": "main" },
    { "from": "gtf", "to": "prepare_order", "variant": "default", "role": "branch" },
    { "from": "prepare_order", "to": "norm", "label": "基因排序表", "variant": "default", "role": "branch" },
    { "from": "prepare_order", "to": "extract", "label": "基因排序表", "variant": "dashed", "role": "branch", "route": "outside-right" }
  ],
  "cards": [
    {
      "dot": "cyan",
      "title": "为什么这么做",
      "items": [
        "缺失区间的权威来源是基因型（CNV 芯片 / WGS / MLPA），表达型推断只是没有基因型时的回退路径",
        "已知区间基因提取只依赖 GRCh38 坐标，不依赖表达信号，永远可靠"
      ]
    },
    {
      "dot": "amber",
      "title": "两个防坑设计",
      "items": [
        "排除 chrX/chrY：性染色体剂量差异会主导信号",
        ">10 Mb 的低信号段多为着丝粒 / 低可比对区伪影，大小过滤剔除"
      ]
    }
  ]
}
